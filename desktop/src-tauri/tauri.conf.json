{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synco",
  "version": "0.0.0",
  "identifier": "app.clipxel.synco",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Synco",
        "width": 1320,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#121417"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "Synco",
    "homepage": "https://clipxel.github.io/Synco/",
    "copyright": "AGPL-3.0",
    "category": "Video",
    "shortDescription": "Sincroniza cámaras y grabadores por el audio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/engine/": "engine/" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } },
    "linux": { "deb": { "depends": ["libxml2", "libcurl4"] } }
  }
}
