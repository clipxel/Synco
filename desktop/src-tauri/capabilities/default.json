{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Synco window may use.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "process:allow-exit"
  ]
}
